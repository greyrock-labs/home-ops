{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	layer4 {
		:443 {
      matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
			# Only TLS crosses the tunnel; anything else on 443 is closed here.
			@tls tls
			route @tls {
				proxy {
					proxy_protocol v2
					upstream 10.1.25.41:8443
				}
			}
		}
		:80 {
			@local_http http host {$VPS_LOCAL_HOSTS}
			route @local_http {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8080
				}
			}
			route {
				proxy {
					proxy_protocol v2
					upstream 10.1.25.41:8080
				}
			}
		}
		:22 {
			# Only SSH crosses the tunnel; anything else on 22 is closed here.
			@ssh ssh
			route @ssh {
				proxy {
					proxy_protocol v2
					upstream 10.1.25.41:8022
				}
			}
		}
	}

	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	log default {
		output stdout
		format json
	}
}

skedaddle-doco-cd.greyrock.io {
	reverse_proxy doco-cd:8880
}

skedaddle-gatus.greyrock.io {
	reverse_proxy gatus:8080
}
