#!/bin/bash
# Kiosk watchdog, run every minute by kiosk-watchdog.timer.
# - Wi-Fi: never tears down a connected link on one bad check. If NM reports
#   wlan0 idle, nudge it to reconnect. If checks keep failing, bounce the radio
#   every 3 failures and reboot at 10.
# - HA: after an outage lasting 2+ checks (HA or network), restart TouchKio
#   once HA answers again, so the page reloads instead of sitting on an error.
#   Shorter blips are left to HA's own frontend reconnect.
set -u

GATEWAY=10.1.10.1
CONN="Grey Rock IoT"
IFACE=wlan0
HA_URL=https://home.internal.greyrock.io/manifest.json
KIOSK_USER=todd
NET_BOUNCE_EVERY=3   # consecutive failed network checks between radio bounces
NET_REBOOT_AT=10     # consecutive failed network checks before rebooting
RELOAD_AFTER=2       # consecutive down checks before recovery restarts TouchKio
STATE=/run/kiosk-watchdog   # tmpfs: counters reset on boot

mkdir -p "$STATE"
log() { logger -t kiosk-watchdog "$*"; }
count() { cat "$STATE/$1" 2>/dev/null || echo 0; }

net_fails=$(count net_fails)
down=$(count down)

# --- Network ---
nm_state=$(nmcli -g GENERAL.STATE device show "$IFACE" 2>/dev/null)
if [[ "$nm_state" == 100* ]] && ping -c 3 -W 2 -q "$GATEWAY" >/dev/null 2>&1; then
    [ "$net_fails" -gt 0 ] && log "network ok after $net_fails failed checks"
    net_fails=0
else
    net_fails=$((net_fails + 1))
    down=$((down + 1))
    log "network check failed ($net_fails): $IFACE '${nm_state:-unknown}'"
    if [ "$net_fails" -ge "$NET_REBOOT_AT" ]; then
        log "network down for $net_fails checks, rebooting"
        systemctl reboot
        exit 0
    elif [ $((net_fails % NET_BOUNCE_EVERY)) -eq 0 ]; then
        log "bouncing wifi radio"
        nmcli radio wifi off; sleep 5; nmcli radio wifi on
    elif [[ "$nm_state" == 20* || "$nm_state" == 30* ]]; then
        # Idle (unavailable/disconnected): nudge. Never interrupt an
        # in-progress activation or a connected link.
        nmcli connection up "$CONN" >/dev/null 2>&1 || true
    fi
    echo "$net_fails" > "$STATE/net_fails"
    echo "$down" > "$STATE/down"
    exit 0
fi
echo "$net_fails" > "$STATE/net_fails"

# --- Home Assistant ---
if curl -sf -m 10 -o /dev/null "$HA_URL"; then
    if [ "$down" -ge "$RELOAD_AFTER" ]; then
        log "HA reachable after $down down checks, restarting touchkio"
        systemctl --user -M "$KIOSK_USER@" restart touchkio.service
    elif [ "$down" -gt 0 ]; then
        log "brief outage ($down check), leaving touchkio alone"
    fi
    down=0
else
    down=$((down + 1))
    log "HA unreachable ($down)"
fi
echo "$down" > "$STATE/down"
