mode: iptables
log_mode: stdout
log_level: info
update_frequency: 10s
# Keep retrying instead of exiting (and flushing the ban rules) if the
# cluster LAPI is unreachable when the bouncer starts.
retry_initial_connect: true
api_url: https://crowdsec-lapi.greyrock.io/
api_key: {{ crowdsec_api_key }}
disable_ipv6: false
deny_action: DROP
deny_log: false
supported_decisions_types:
  - ban
iptables_chains:
  - INPUT
  - FORWARD
  - DOCKER-USER
